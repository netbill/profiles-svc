# Service (optional, defaults shown)
SERVICE_NAME=profiles-svc
LOG_LEVEL=debug
LOG_FORMAT=text

# REST
REST_PORT=8002
# optional, defaults shown
REST_READ_TIMEOUT=15s
REST_READ_HEADER_TIMEOUT=15s
REST_WRITE_TIMEOUT=15s
REST_IDLE_TIMEOUT=60s

# Database
DATABASE_SQL_URL=postgresql://postgres:postgres@localhost:7002/postgres?sslmode=disable

# Auth
AUTH_TOKENS_ACCOUNT_ACCESS_SECRET_KEY=UnG06MAU2i1Mvqf8
# optional, default shown
AUTH_TOKENS_ISSUER=profiles-svc

# S3 (avatar storage)
S3_AWS_REGION=us-east-1
S3_AWS_BUCKET_NAME=my-app-media
S3_AWS_ACCESS_KEY_ID=your-access-key-id
S3_AWS_SECRET_ACCESS_KEY=your-secret-access-key
S3_AWS_BASE_URL=https://s3.amazonaws.com/my-app-bucket
# optional, blank unless using temporary/session credentials
S3_AWS_SESSION_TOKEN=

# optional, defaults shown
S3_MEDIA_LINK_TTL=24h
S3_MEDIA_PROFILE_AVATAR_ALLOWED_FORMATS=jpeg,jpg,png,gif
S3_MEDIA_PROFILE_AVATAR_MAX_WIDTH=512
S3_MEDIA_PROFILE_AVATAR_MIN_WIDTH=512
S3_MEDIA_PROFILE_AVATAR_MAX_HEIGHT=512
S3_MEDIA_PROFILE_AVATAR_MIN_HEIGHT=512
S3_MEDIA_PROFILE_AVATAR_CONTENT_SIZE_MAX=5242880

# Kafka
KAFKA_BROKERS=localhost:9092
# optional, default shown — used as consumer group / client id
KAFKA_IDENTITY=profiles-svc

# optional, defaults shown
KAFKA_CONSUME_BACKOFF_MIN=100ms
KAFKA_CONSUME_BACKOFF_MAX=1s

KAFKA_CONSUME_ACCOUNTS_V1_INSTANCES=4
KAFKA_CONSUME_ACCOUNTS_V1_MIN_BYTES=1
KAFKA_CONSUME_ACCOUNTS_V1_MAX_BYTES=10000000
KAFKA_CONSUME_ACCOUNTS_V1_MAX_WAIT=1s
KAFKA_CONSUME_ACCOUNTS_V1_QUEUE_CAPACITY=10

KAFKA_PRODUCE_PROFILES_V1_REQUIRED_ACKS=all
KAFKA_PRODUCE_PROFILES_V1_COMPRESSION=snappy
KAFKA_PRODUCE_PROFILES_V1_BALANCER=hash
KAFKA_PRODUCE_PROFILES_V1_BATCH_SIZE=100
KAFKA_PRODUCE_PROFILES_V1_BATCH_TIMEOUT=10ms

KAFKA_INBOX_ROUTINES=10
KAFKA_INBOX_SLOTS=40
KAFKA_INBOX_BATCH_SIZE=100
KAFKA_INBOX_SLEEP=100ms
KAFKA_INBOX_MIN_NEXT_ATTEMPT=1m
KAFKA_INBOX_MAX_NEXT_ATTEMPT=10m
KAFKA_INBOX_MAX_ATTEMPTS=0

KAFKA_OUTBOX_ROUTINES=10
KAFKA_OUTBOX_SLOTS=40
KAFKA_OUTBOX_BATCH_SIZE=100
KAFKA_OUTBOX_SLEEP=100ms
KAFKA_OUTBOX_MIN_NEXT_ATTEMPT=1m
KAFKA_OUTBOX_MAX_NEXT_ATTEMPT=10m
KAFKA_OUTBOX_MAX_ATTEMPTS=0
